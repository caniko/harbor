{
  // Tools resolve from the direnv-loaded shell (mkhl.direnv) or .venv,
  // never from extension-bundled copies.
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
  "python.languageServer": "None",
  "basedpyright.importStrategy": "fromEnvironment",
  "ruff.importStrategy": "fromEnvironment",
  "ruff.nativeServer": "on",
  "[python]": { "editor.defaultFormatter": "charliermarsh.ruff" },
  "rust-analyzer.server.path": "${workspaceFolder}/.vscode/rust-analyzer",
  "rust-analyzer.check.command": "clippy",
  "[rust]": { "editor.defaultFormatter": "rust-lang.rust-analyzer" }
}
