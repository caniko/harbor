diff --git a/share/nix-direnv/direnvrc b/share/nix-direnv/direnvrc
--- a/share/nix-direnv/direnvrc
+++ b/share/nix-direnv/direnvrc
@@ -210,6 +210,70 @@
   done
 }
 
+_nix_realize_id() {
+  local sum
+  sum=$(@coreutils@/bin/sha1sum <<<"$1")
+  echo "${sum:0:16}"
+}
+
+# Serialize renewals of one profile for the rest of this direnv run, so a
+# concurrent activation cannot remove this renewal's profile links. Called
+# outside the command substitution that runs _nix_print_dev_env. Never
+# unlinked: flock state belongs to the inode.
+declare -gA _nix_direnv_realize_locks=()
+_nix_realize_lock() {
+  local lock fd
+  lock="${1%/*}/.realize-$(_nix_realize_id "$1").lock"
+  [[ -v _nix_direnv_realize_locks["$lock"] ]] && return 0
+  if exec {fd}>>"$lock" && @flock@ "$fd"; then
+    _nix_direnv_realize_locks["$lock"]=$fd
+  else
+    # Unserialized renewals still work, and failures still reach the fallback.
+    _nix_direnv_warning "could not lock ${lock}; concurrent renewals are not serialized"
+  fi
+}
+
+# Realize the shell in a user unit so an interrupted activation (Ctrl-C, editor
+# or agent timeout) only stops waiting: the build finishes once, and its
+# --profile link roots the closure for the next activation. Without a user
+# systemd this is the plain inline call.
+_nix_print_dev_env() {
+  local tmp_profile=$1
+  shift
+  if ! command -v systemd-run >/dev/null || ! systemctl --user show --property=Version --value >/dev/null 2>&1; then
+    _nix print-dev-env --profile "$tmp_profile" "$@"
+    return
+  fi
+  local unit
+  unit="nix-direnv-$(_nix_realize_id "$tmp_profile")"
+  # A unit left running by an interrupted activation is joined, not restarted.
+  if ! systemctl --user is-active --quiet "$unit"; then
+    @coreutils@/bin/rm -f "$tmp_profile.rc" "$tmp_profile.status" "$tmp_profile.log"
+    local -a env=()
+    local name
+    for name in $(compgen -e); do
+      [[ $name == DIRENV_* ]] && continue
+      env+=("--setenv=$name")
+    done
+    systemd-run --user --quiet --collect --same-dir --unit="$unit" "${env[@]}" -- \
+      "$BASH" -c '"$@" >"$0.rc" 2>"$0.log"; echo $? >"$0.status"' "$tmp_profile" \
+      "$_nix_direnv_nix" --no-warn-dirty --extra-experimental-features "nix-command flakes" \
+      print-dev-env --profile "$tmp_profile" "$@" || return 1
+  fi
+  _nix_direnv_info "realizing in user unit $unit; interrupting only stops this wait (log: $tmp_profile.log)"
+  @coreutils@/bin/tail -n +1 -F --pid=$$ "$tmp_profile.log" >&2 2>/dev/null &
+  local tail_pid=$!
+  # ponytail: 1 s polling; subscribe to unit state changes if latency matters.
+  while systemctl --user is-active --quiet "$unit"; do
+    @coreutils@/bin/sleep 1
+  done
+  kill "$tail_pid" 2>/dev/null
+  local status=
+  [[ -s "$tmp_profile.status" ]] && read -r status <"$tmp_profile.status"
+  [[ $status == 0 ]] || return 1
+  @coreutils@/bin/cat "$tmp_profile.rc"
+}
+
 _nix_add_gcroot() {
   local storepath=$1
   local symlink=$2
@@ -375,8 +439,9 @@
 
     else
