--- a/blender_extension/nodes/serialization.py
+++ b/blender_extension/nodes/serialization.py
@@ -75,5 +75,12 @@
     if hasattr(value, "to_list"):
         return _gn_json_value(value.to_list())
+    if hasattr(value, "to_tuple") and not isinstance(value, (str, bytes, dict)):
+        # Canix: mathutils Vector/Color/Euler/Quaternion expose to_tuple()
