+import { beforeAll, describe, expect, spyOn, test } from 'bun:test'
+
+import { SkiaRenderer } from '@open-pencil/core/canvas'
+import { getCanvasKit } from '@open-pencil/core/canvaskit'
+import { createEditor } from '@open-pencil/core/editor'
+import { BUILTIN_IO_FORMATS, IORegistry } from '@open-pencil/core/io'
+import { getTextMeasurer } from '@open-pencil/core/layout'
+import { fontManager } from '@open-pencil/core/text'
+import { SceneGraph } from '@open-pencil/scene-graph'
+
+import { createExportTargetActions } from '@/app/document/export/files'
+
+import { expectDefined } from '#tests/helpers/assert'
+
+beforeAll(async () => {
+  fontManager.markLoaded(
+    'Inter',
+    'Regular',
+    await Bun.file('public/Inter-Regular.ttf').arrayBuffer()
+  )
+})
+
+function fixture() {
+  const graph = new SceneGraph()
+  const page = graph.getPages()[0]
+  const node = graph.createNode('RECTANGLE', page.id, { width: 40, height: 20 })
+  const editor = createEditor({ graph })
+  const actions = createExportTargetActions(
+    editor,
+    editor.state,
+    new IORegistry(BUILTIN_IO_FORMATS)
+  )
+  return { graph, page, node, editor, ...actions }
+}
+
+async function dimensions(bytes: Uint8Array | null) {
+  const ck = await getCanvasKit()
+  const image = expectDefined(
+    ck.MakeImageFromEncoded(expectDefined(bytes, 'export bytes')),
+    'image'
+  )
+  try {
+    return [image.width(), image.height()]
+  } finally {
+    image.delete()
+  }
+}
+
+describe('document raster export', () => {
+  test('renders text pixels without rewriting missing-font metadata', async () => {
+    const f = fixture()
+    const node = f.graph.createNode('TEXT', f.page.id, {
+      text: 'Visible export',
+      fontFamily: 'CanixMissingFont',
+      fontSize: 24,
+      width: 200,
+      height: 40,
+      fills: [{ type: 'SOLID', color: { r: 0, g: 0, b: 0, a: 1 }, opacity: 1, visible: true }]
+    })
+    const before = structuredClone(node)
+    // An unavailable remote face is deterministic; fallback shaping still uses
+    // the real bundled font and CanvasKit, including the emitted pixels.
+    const remote = spyOn(fontManager, 'loadRemoteFont').mockResolvedValue(null)
+    let bytes: Uint8Array
+    try {
+      bytes = expectDefined(await f.renderExportImage([node.id], 1, 'PNG'))
+    } finally {
+      remote.mockRestore()
+    }
+    const ck = await getCanvasKit()
+    const image = expectDefined(ck.MakeImageFromEncoded(bytes))
+    try {
+      const pixels = expectDefined(
+        image.readPixels(0, 0, {
+          width: image.width(),
+          height: image.height(),
+          colorType: ck.ColorType.RGBA_8888,
+          alphaType: ck.AlphaType.Unpremul,
+          colorSpace: ck.ColorSpace.SRGB
+        })
+      )
+      let ink = 0
+      for (let i = 3; i < pixels.length; i += 4) if (pixels[i] > 0) ink++
+      expect(ink).toBeGreaterThan(100)
+    } finally {
+      image.delete()
+    }
+    expect(node).toEqual(before)
+  })
+
+  test('releases export resources after font failure and leaves the live renderer usable', async () => {
+    const f = fixture()
+    const ck = await getCanvasKit()
+    const live = new SkiaRenderer(ck, expectDefined(ck.MakeSurface(1, 1)))
+    await live.loadFonts()
+    const previousProvider = fontManager.provider()
+    const previousMeasurer = getTextMeasurer()
+    const load = spyOn(fontManager, 'ensureFallbackPack').mockRejectedValueOnce(
+      new Error('font failure')
+    )
+    try {
+      await expect(f.renderExportImage([f.node.id], 1, 'PNG')).rejects.toThrow('font failure')
+      expect(fontManager.provider()).toBe(previousProvider)
+      expect(getTextMeasurer()).toBe(previousMeasurer)
+      expect(live.isDestroyed()).toBe(false)
+    } finally {
+      load.mockRestore()
+    }
+    try {
+      expect(await dimensions(await f.renderExportImage([f.node.id], 1, 'PNG'))).toEqual([40, 20])
+      expect(live.getFontProvider()).toBe(previousProvider)
+    } finally {
+      live.destroy()
+    }
+  })
+
+  test('exports an unmounted document including unsaved changes', async () => {
+    const f = fixture()
+    f.graph.updateNode(f.node.id, { width: 73 })
+    expect(f.editor.renderer).toBeNull()
+    expect(await dimensions(await f.renderExportImage([f.node.id], 1, 'PNG'))).toEqual([73, 20])
+  })
+
+  test('exports a non-current page without changing document state', async () => {
+    const f = fixture()
+    const other = f.graph.addPage('Other')
+    const node = f.graph.createNode('RECTANGLE', other.id, { width: 91, height: 37 })
+    f.editor.select([f.node.id])
+    const before = structuredClone([...f.graph.getAllNodes()])
+    const selection = [...f.editor.state.selectedIds]
+    expect(await dimensions(await f.renderExportImage([node.id], 1, 'PNG', other.id))).toEqual([
+      91, 37
+    ])
+    expect([...f.graph.getAllNodes()]).toEqual(before)
+    expect(f.editor.state.currentPageId).toBe(f.page.id)
+    expect([...f.editor.state.selectedIds]).toEqual(selection)
+  })
+
+  test('captures content before asynchronous rendering starts', async () => {
+    const f = fixture()
+    const first = f.renderExportImage([f.node.id], 1, 'PNG')
+    f.graph.updateNode(f.node.id, { width: 83 })
+    const second = f.renderExportImage([f.node.id], 1, 'PNG')
+    expect(await dimensions(await first)).toEqual([40, 20])
+    expect(await dimensions(await second)).toEqual([83, 20])
+  })
+
+  test('rejects cross-page nodes and allows the next export', async () => {
+    const f = fixture()
+    const other = f.graph.addPage('Other')
+    await expect(f.renderExportImage([f.node.id], 1, 'PNG', other.id)).rejects.toThrow()
+    expect(await dimensions(await f.renderExportImage([f.node.id], 1, 'PNG'))).toEqual([40, 20])
+  })
+
+  test('a failed export does not poison queued exports from another document', async () => {
+    const first = fixture()
+    const second = fixture()
+    second.graph.updateNode(second.node.id, { width: 109 })
+    const load = spyOn(fontManager, 'ensureFallbackPack').mockRejectedValueOnce(
+      new Error('first document failed')
+    )
+    const destroy = spyOn(SkiaRenderer.prototype, 'destroy')
+    try {
+      const results = await Promise.allSettled([
+        first.renderExportImage([first.node.id], 1, 'PNG'),
+        second.renderExportImage([second.node.id], 1, 'PNG')
+      ])
+      expect(results[0]).toMatchObject({ status: 'rejected' })
+      const successful = results[1]
+      expect(successful.status).toBe('fulfilled')
+      if (successful.status !== 'fulfilled') throw successful.reason
+      expect(await dimensions(successful.value)).toEqual([109, 20])
+      expect(destroy).toHaveBeenCalledTimes(2)
+      expect(await dimensions(await first.renderExportImage([first.node.id], 1, 'PNG'))).toEqual([
+        40, 20
+      ])
+    } finally {
+      load.mockRestore()
+      destroy.mockRestore()
+    }
+  })
+})
