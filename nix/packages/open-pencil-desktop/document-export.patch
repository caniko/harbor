+import { SkiaRenderer } from '@open-pencil/core/canvas'
+import { getCanvasKit } from '@open-pencil/core/canvaskit'
+import { extractExportGraph, type RasterExportFormat } from '@open-pencil/core/io'
+import { renderNodesToImage } from '@open-pencil/core/io/formats/raster'
+import {
+  collectGraphFontRequirements,
+  collectNodeFontFaces,
+  fontFaceDemand,
+  fontManager,
+  fontResolver,
+  missingGraphFontScripts
+} from '@open-pencil/core/text'
+import type { SceneGraph } from '@open-pencil/scene-graph'
+
+// CanvasKit and font caches are shared. Each job owns its surface and graph;
+// serializing exports also avoids racing the initial CanvasKit load.
+let pendingExport: Promise<unknown> = Promise.resolve()
+
+export function renderDocumentImage(
+  source: SceneGraph,
+  pageId: string,
+  nodeIds: string[],
+  scale: number,
+  format: RasterExportFormat
+): Promise<Uint8Array | null> {
+  // Capture before yielding: later edits and tab switches cannot change this job.
+  const { graph } = extractExportGraph(source, { scope: 'page', pageId })
+  const ids = [...nodeIds]
+  if (graph.getNode(pageId)?.type !== 'CANVAS' || ids.some((id) => !graph.getNode(id))) {
+    return Promise.reject(new Error('Raster export nodes must belong to the requested page'))
+  }
+  const result = pendingExport.then(async () => {
+    const ck = await getCanvasKit()
+    const surface = ck.MakeSurface(1, 1)
+    if (!surface) throw new Error('Cannot create raster export surface')
+    const renderer = new SkiaRenderer(ck, surface)
+    try {
+      await renderer.loadFonts()
+      const requirements = collectGraphFontRequirements(graph, ids)
+      await Promise.all(
+        requirements.nodes
+          .flatMap(collectNodeFontFaces)
+          .map(({ family, style }) =>
+            fontResolver.demand(fontFaceDemand(family, style, requirements.characters))
+          )
+      )
+      await fontManager.ensureFallbackPack(
+        missingGraphFontScripts(requirements),
+        requirements.characters
+      )
+      // Export the captured layout. Do not install a global text measurer or
+      // recompute layout on the live editor graph while fonts are loading.
+      return renderNodesToImage(ck, renderer, graph, pageId, ids, { scale, format })
+    } finally {
+      renderer.destroy()
+    }
+  })
+  pendingExport = result.catch(() => undefined)
+  return result
+}
