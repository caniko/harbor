+import { expect, test } from '@playwright/test'
+
+import { CanvasHelper } from '#tests/helpers/canvas'
+
+test('tab switches release the correct renderer and both export bridges honor the page', async ({
+  page
+}) => {
+  const canvas = new CanvasHelper(page)
+  await page.goto('/?test')
+  await canvas.waitForInit()
+  const first = await page.evaluateHandle(async () => {
+    const tabs = await import('/src/app/tabs/index.ts')
+    const store = tabs.getActiveStore()
+    store.state.documentName = 'Export first'
+    const other = store.graph.addPage('Non-current export')
+    const node = store.graph.createNode('RECTANGLE', other.id, { width: 91, height: 37 })
+    return { store, pageId: other.id, nodeId: node.id, tabId: tabs.getActiveTabId() }
+  })
+  try {
+    await page.evaluate(async () => {
+      const tabs = await import('/src/app/tabs/index.ts')
+      tabs.createTab().store.state.documentName = 'Export second'
+    })
+    await canvas.waitForInit()
+    await expect.poll(() => first.evaluate(({ store }) => store.renderer === null)).toBe(true)
+    const exports = await first.evaluate(async ({ store, pageId, nodeId, tabId }) => {
+      const { makeFigmaFromStore } = await import('/src/app/automation/bridge/figma-factory.ts')
+      const { handleExport } = await import('/src/app/automation/bridge/export-handlers.ts')
+      const { resolveAutomationTarget } = await import('/src/app/automation/bridge/target.ts')
+      const currentPage = store.state.currentPageId
+      const api = makeFigmaFromStore(store, pageId)
+      const fromAPI = await api.exportImage([nodeId], { scale: 1, format: 'PNG' })
+      const target = resolveAutomationTarget(store, { document_id: tabId, page_id: pageId })
+      const fromHandler = await handleExport(target, { nodeIds: [nodeId] })
+      return {
+        api: fromAPI ? Array.from(fromAPI) : null,
+        handler: fromHandler,
+        currentPageUnchanged: currentPage === store.state.currentPageId
+      }
+    })
+    expect(exports.currentPageUnchanged).toBe(true)
+    expect(exports.api?.slice(0, 8)).toEqual([137, 80, 78, 71, 13, 10, 26, 10])
+    const bytes = Buffer.from(exports.api ?? [])
+    expect([bytes.readUInt32BE(16), bytes.readUInt32BE(20)]).toEqual([91, 37])
+    expect(exports.handler).toMatchObject({
+      ok: true,
+      result: { mimeType: 'image/png', base64: bytes.toString('base64') }
+    })
+    await page.getByTestId('tabbar-tab').filter({ hasText: 'Export first' }).click()
+    await canvas.waitForInit()
+    expect(await first.evaluate(({ store }) => store.renderer?.isDestroyed())).toBe(false)
+    await page.getByTestId('tabbar-tab').filter({ hasText: 'Export second' }).click()
+    await canvas.waitForInit()
+    await expect.poll(() => first.evaluate(({ store }) => store.renderer === null)).toBe(true)
+    canvas.assertNoErrors()
+  } finally {
+    await first.dispose()
+  }
+})
