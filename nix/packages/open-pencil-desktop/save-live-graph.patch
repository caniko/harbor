@@ -0,0 +1,31 @@
+/**
+ * Saving must encode the live scene graph. Reusing the archive the document
+ * was opened from lost edits that emit no node event (variables, collections)
+ * and hung forever when the parse worker no longer answered.
+ */
+import { expect, test } from 'bun:test'
+
+import { SceneGraph } from '@open-pencil/scene-graph'
+
+import { exportFigFile } from '#core/io/formats/fig/export'
+import { parseFigFile } from '#core/io/formats/fig/read'
+import { registerOriginalArchiveRequest } from '#core/kiwi/fig/population/client'
+
+test('export does not wait for an unanswered original-archive request', async () => {
+  const graph = new SceneGraph()
+  registerOriginalArchiveRequest(graph, () => new Promise<Uint8Array>(() => {}))
+  expect((await exportFigFile(graph)).byteLength).toBeGreaterThan(0)
+}, 5000)
+
+test('export keeps a variable added after opening', async () => {
+  const graph = new SceneGraph()
+  registerOriginalArchiveRequest(graph, async () => new Uint8Array([1, 2, 3]))
+  const collection = graph.createCollection('Tokens')
+  graph.createVariable('brand', 'COLOR', collection.id, { r: 1, g: 0, b: 0, a: 1 })
+
+  const out = await exportFigFile(graph)
+  const reread = await parseFigFile(
+    out.buffer.slice(out.byteOffset, out.byteOffset + out.byteLength) as ArrayBuffer
+  )
+  expect([...reread.variables.values()].map((v) => v.name)).toContain('brand')
+})
