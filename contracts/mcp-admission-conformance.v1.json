{
  "version": 1,
  "server": { "connectionId": "fixture", "name": "A provider-independent reader", "url": "https://tools.example/mcp" },
  "policy": { "version": 1, "servers": { "fixture": { "url": "https://tools.example/mcp", "gatewayUrl": "https://worker.example/profile/main", "serverHostId": "host-a", "executionHostIds": ["host-a", "host-b"] } } },
  "cases": [
    { "name": "same host", "runId": "run-a", "executionHostId": "host-a", "expectedCrossHost": false },
    { "name": "explicit cross host", "runId": "run-a", "executionHostId": "host-b", "expectedCrossHost": true },
    { "name": "unapproved host", "runId": "run-a", "executionHostId": "host-c", "expectedReason": "execution_host_not_authorized" },
    { "name": "missing run", "runId": "", "executionHostId": "host-a", "expectedReason": "invalid_identity" },
    { "name": "whitespace identity", "runId": "run a", "executionHostId": "host-a", "expectedReason": "invalid_identity" },
    { "name": "trailing newline identity", "runId": "run-a\n", "executionHostId": "host-a", "expectedReason": "invalid_identity" },
    { "name": "wrong endpoint", "runId": "run-a", "executionHostId": "host-a", "url": "https://tools.example/mcp/", "expectedReason": "endpoint_mismatch" },
    { "name": "wrong connection", "runId": "run-a", "executionHostId": "host-a", "connectionId": "other", "expectedReason": "server_not_authorized" },
    { "name": "inherited connection", "runId": "run-a", "executionHostId": "host-a", "connectionId": "constructor", "expectedReason": "server_not_authorized" },
    { "name": "unsafe HTTP recipient", "runId": "run-a", "executionHostId": "host-a", "gatewayUrl": "http://remote.example", "expectedReason": "unsafe_endpoint" },
    { "name": "recipient query", "runId": "run-a", "executionHostId": "host-a", "gatewayUrl": "https://worker.example?secret=x", "expectedReason": "unsafe_endpoint" },
    { "name": "recipient userinfo", "runId": "run-a", "executionHostId": "host-a", "gatewayUrl": "https://user:secret@worker.example", "expectedReason": "unsafe_endpoint" },
    { "name": "recipient fragment", "runId": "run-a", "executionHostId": "host-a", "gatewayUrl": "https://worker.example#fragment", "expectedReason": "unsafe_endpoint" },
    { "name": "trailing newline recipient", "runId": "run-a", "executionHostId": "host-a", "gatewayUrl": "https://worker.example/\n", "expectedReason": "unsafe_endpoint" },
    { "name": "loopback HTTP", "runId": "run-a", "executionHostId": "host-a", "gatewayUrl": "http://127.0.0.1:9119/chat", "expectedCrossHost": false },
    { "name": "IPv6 loopback HTTP", "runId": "run-a", "executionHostId": "host-a", "gatewayUrl": "http://[::1]:8642", "expectedCrossHost": false },
    { "name": "profile recipient", "runId": "run-b", "executionHostId": "host-a", "gatewayUrl": "https://worker.example/p/secondary/api", "expectedCrossHost": false }
  ]
}
